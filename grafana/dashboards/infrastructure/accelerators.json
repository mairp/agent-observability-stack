    {
      "id": 103,
      "type": "stat",
      "title": "Fleet GPU verdict (watchdog)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "agentops_gpu_degraded from gpu-watchdog.timer \u2014 the authoritative wedge signal, and what the AgentOpsGPUDegraded alert fires on. It flips to 1 on an Xid-79 'fell off the bus' event, where the card is still PCIe-enumerated but unresponsive and only a host reboot clears it. Read it together with the NVIDIA tile: PRESENT + DEGRADED means enumerated-but-wedged.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "HEALTHY",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "DEGRADED",
                  "color": "red",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "WATCHDOG DOWN",
                  "color": "purple",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "legendFormat": "Fleet GPU verdict",
          "expr": "agentops_gpu_degraded"
        }
      ]
    },
