{
  "uid": "accelerators",
  "title": "Accelerators (NVIDIA + iGPU + NPU)",
  "tags": [
    "infra",
    "gpu",
    "npu",
    "nvidia"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 100,
      "type": "stat",
      "title": "NVIDIA RTX 3090 (eGPU)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every NVIDIA panel below is driven by exporters/nvidia_gpu_textfile.sh. ABSENT means the Thunderbolt eGPU is powered down or wedged (Xid 79 'fell off the bus', which only a host reboot clears) \u2014 the panels below will read No data, and that is the correct rendering of a card that is not there. Fixed 2026-08-27: nvidia-smi prints \"No devices were found\" on STDOUT, which the collector used to count as a sample and publish present=1, hiding exactly this outage behind No-data panels.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ABSENT",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "PRESENT",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "COLLECTOR DOWN",
                  "color": "purple",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "legendFormat": "NVIDIA RTX 3090 (eGPU)",
          "expr": "nvidia_gpu_present"
        }
      ]
    },
