{
  "uid": "llm-cost",
  "title": "LLM Cost & Consumption (Unified)",
  "tags": [
    "ai",
    "cost"
  ],
  "schemaVersion": 39,
  "version": 4,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Agent service (Loki meter)",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({service_name!=\"\"}, service_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model",
        "label": "Model (LiteLLM meter)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(litellm_total_tokens_metric_total, model)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "definition": "label_values(litellm_total_tokens_metric_total, model)",
        "description": "Sourced from the token counters over the dashboard range (not the live inventory) so retired models with history stay selectable."
      },
      {
        "name": "local_models",
        "label": "Local (RTX 3090) model regex",
        "type": "textbox",
        "description": "Regex over the LiteLLM `model` label that marks a route as served by llama-swap on the RTX 3090. Retired aliases (qwen3-coder-30b-a3b, qwen3.6-27b, qwen3.8-27b-q4) still match so 30d history stays in.",
        "query": "qwen.*|muse-.*|nemotron-.*|antares",
        "current": {
          "text": "qwen.*|muse-.*|nemotron-.*|antares",
          "value": "qwen.*|muse-.*|nemotron-.*|antares"
        },
        "options": [
          {
            "text": "qwen.*|muse-.*|nemotron-.*|antares",
            "value": "qwen.*|muse-.*|nemotron-.*|antares",
            "selected": true
          }
        ],
        "hide": 0
      },
      {
        "name": "ref_in",
        "label": "Ref. price — input $/MTok",
        "description": "What one uncached input token would have cost had the call gone to the cloud. gpt-5 is the literal target: litellm config wires fallbacks from every local route to gpt-5. Open-weight host median = replacement cost of running the same GGUF elsewhere (OpenRouter, 2026-09-11).",
        "type": "custom",
        "multi": false,
        "includeAll": false,
        "query": "gpt-5 fallback $1.25 : 1.25, open-weight host median $0.31 : 0.31, gpt-5.6-sol $4.00 : 4, nemotron host $0.09 : 0.09",
        "options": [
          {
            "text": "gpt-5 fallback $1.25",
            "value": "1.25",
            "selected": true
          },
          {
            "text": "open-weight host median $0.31",
            "value": "0.31",
            "selected": false
          },
          {
            "text": "gpt-5.6-sol $4.00",
            "value": "4",
            "selected": false
          },
          {
            "text": "nemotron host $0.09",
            "value": "0.09",
            "selected": false
          }
        ],
        "current": {
          "text": "gpt-5 fallback $1.25",
          "value": "1.25",
          "selected": true
        },
        "hide": 0
      },
      {
        "name": "ref_cached",
        "label": "Ref. price — cached input $/MTok",
        "description": "Price for a prompt-cache hit. gpt-5 bills cached input at 10% of list. Most open-weight hosts give no cache discount, so pick the same value as input for that basis.",
        "type": "custom",
        "multi": false,
        "includeAll": false,
        "query": "gpt-5 cached $0.125 : 0.125, no discount (host median) $0.31 : 0.31, gpt-5.6-sol cached $0.40 : 0.4",
        "options": [
          {
            "text": "gpt-5 cached $0.125",
            "value": "0.125",
            "selected": true
          },
          {
            "text": "no discount (host median) $0.31",
            "value": "0.31",
            "selected": false
          },
          {
            "text": "gpt-5.6-sol cached $0.40",
            "value": "0.4",
            "selected": false
          }
        ],
        "current": {
          "text": "gpt-5 cached $0.125",
          "value": "0.125",
          "selected": true
        },
        "hide": 0
      },
      {
        "name": "ref_out",
        "label": "Ref. price — output $/MTok",
        "description": "What one generated token would have cost in the cloud. Same bases as the input price.",
        "type": "custom",
        "multi": false,
        "includeAll": false,
        "query": "gpt-5 fallback $10.00 : 10, open-weight host median $2.65 : 2.65, gpt-5.6-sol $20.00 : 20, nemotron host $0.225 : 0.225",
        "options": [
          {
            "text": "gpt-5 fallback $10.00",
            "value": "10",
            "selected": true
          },
          {
            "text": "open-weight host median $2.65",
            "value": "2.65",
            "selected": false
          },
          {
            "text": "gpt-5.6-sol $20.00",
            "value": "20",
            "selected": false
          },
          {
            "text": "nemotron host $0.225",
            "value": "0.225",
            "selected": false
          }
        ],
        "current": {
          "text": "gpt-5 fallback $10.00",
          "value": "10",
          "selected": true
        },
        "hide": 0
      },
      {
        "name": "kwh_price",
        "label": "Electricity $/kWh",
        "type": "textbox",
        "description": "Your tariff. Only the RTX 3090's own draw (llamaswap_gpu_power_draw_watts) is metered — host, enclosure and PSU losses are not.",
        "query": "0.25",
        "current": {
          "text": "0.25",
          "value": "0.25"
        },
        "options": [
          {
            "text": "0.25",
            "value": "0.25",
            "selected": true
          }
        ],
        "hide": 0
      }
    ]
