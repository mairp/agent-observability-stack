          "refId": "output",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table",
          "expr": "label_replace(sum by (model)(increase(litellm_output_tokens_metric_total{model=~\"$local_models\"}[$__range])), \"litellm_model_name\", \"$1\", \"model\", \"(.*)\")"
        },
        {
          "refId": "avoided",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table",
          "expr": "label_replace(( (sum by (model)(increase(litellm_input_tokens_metric_total{model=~\"$local_models\"}[$__range])) - sum by (model)(increase(litellm_input_cached_tokens_metric_total{model=~\"$local_models\"}[$__range]))) * $ref_in + sum by (model)(increase(litellm_input_cached_tokens_metric_total{model=~\"$local_models\"}[$__range])) * $ref_cached + sum by (model)(increase(litellm_output_tokens_metric_total{model=~\"$local_models\"}[$__range])) * $ref_out ) / 1e6, \"litellm_model_name\", \"$1\", \"model\", \"(.*)\")"
        }
