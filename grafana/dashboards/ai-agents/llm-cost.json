              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "model": true,
              "model 1": true,
              "model 2": true,
              "model 3": true,
              "model 4": true
            },
            "renameByName": {
              "Value #requests": "requests",
              "Value #failures": "failures",
              "Value #input": "input tokens",
              "Value #cached": "cached input",
              "Value #output": "output tokens",
              "Value #avoided": "avoided"
            }
          }
        }
      ]
