      "title": "Loaded model (llama-swap)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "unloaded",
                  "color": "transparent"
                },
                "1": {
                  "text": "loaded",
                  "color": "green"
                }
              }
            }
          ],
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (model) (llamaswap_model_loaded)",
          "legendFormat": "{{model}}"
        }
      ]
    },
