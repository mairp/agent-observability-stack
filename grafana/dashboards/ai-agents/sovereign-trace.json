{
  "uid": "sovereign-trace",
  "title": "Request trace",
  "tags": [
    "tempo",
    "traces"
  ],
  "description": "One request's trace, opened by link with ?var-trace=<trace id>&var-span=<span id>. The two tables are TraceQL searches, streamed by Grafana over gRPC to Tempo's HTTP port (Tempo's stream_over_http_enabled). Seven days: Tempo keeps traces for 168h and refuses a longer search range.",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "trace",
        "label": "trace id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "span",
        "label": "span id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "request",
        "label": "request id",
        "type": "textbox",
        "query": "",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "The span that was linked",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Trace **`$trace`** · span **`$span`** · request **`$request`**\n\nFind the span in the waterfall below, or open *Span Filters* and paste the span id. The stage table matches the request id when the link carries one, and the trace id otherwise."
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "The linked span",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ span:id = \"$span\" } | select(name, span.sov.stage, span.sov.stage_index, span.sov.stage_status, span.sov.stage_applied, span.sov.stage_latency_ms, span.sov.budget_family, span.sov.request_id)",
          "limit": 1,
          "spss": 1,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceService": true,
              "traceName": true
            },
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "The fifteen stages of this request",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ (span.sov.request_id = \"$request\" || trace:id = \"$trace\") && name =~ \"sov.stage.*\" } | select(span.sov.stage_index, span.sov.stage_status, span.sov.stage_applied, span.sov.stage_latency_ms)",
          "limit": 1,
          "spss": 50,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceService": true,
              "traceName": true
            },
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "traces",
      "title": "Waterfall — every span of the trace",
      "gridPos": {
        "h": 30,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "$trace"
        }
      ]
    }
  ]
}
