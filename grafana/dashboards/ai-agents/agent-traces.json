{
  "uid": "agent-traces",
  "title": "Agent Traces (Claude Code, dsh, LiteLLM)",
  "tags": [
    "ai",
    "traces",
    "claude-code",
    "dsh",
    "litellm",
    "phoenix"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "query": "claude-code,dsh,litellm-gateway",
        "includeAll": true,
        "multi": true,
        "allValue": "claude-code|dsh|litellm-gateway",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About this dashboard",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Agent traces** from Claude Code (`claude_code.*`, beta), dsh (`dsh.*`, local plugin) and the LiteLLM gateway (`litellm_*`, arize_phoenix callback). Rates/latency come from Tempo span-metrics (`traces_spanmetrics_*`, labels `llm_model_name` / `gen_ai_request_model`). Full prompts/completions: open a trace here, or the same trace in **Phoenix** (Phoenix UI (host port 3006), projects `claude-code`, `dsh`, `litellm-gateway`, `specstride`). SpecStride runs: see *SpecStride Runs & Traces*."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "LLM calls / min by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_name=~\"claude_code.llm_request|dsh.llm|litellm_request\"}[5m])) * 60",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "LLM call p95 latency by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_name=~\"claude_code.llm_request|dsh.llm|litellm_request\"}[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LLM call error ratio by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_name=~\"claude_code.llm_request|dsh.llm|litellm_request\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_name=~\"claude_code.llm_request|dsh.llm|litellm_request\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "LiteLLM gateway",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Gateway calls / min by model",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (llm_model_name) (rate(traces_spanmetrics_calls_total{service=\"litellm-gateway\", span_name=\"litellm_request\"}[5m])) * 60",
          "legendFormat": "{{llm_model_name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Gateway p95 latency by model",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, llm_model_name) (rate(traces_spanmetrics_latency_bucket{service=\"litellm-gateway\", span_name=\"litellm_request\"}[5m])))",
          "legendFormat": "{{llm_model_name}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Failed upstream attempts / min by model (errors, retries, fallbacks taken)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (llm_model_name) (rate(traces_spanmetrics_calls_total{service=\"litellm-gateway\", span_name=\"litellm_request\", status_code=\"STATUS_CODE_ERROR\"}[5m])) * 60",
          "legendFormat": "{{llm_model_name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Gateway calls (click a trace; failed attempts next to the fallback that answered)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"litellm-gateway\" && name=\"litellm_request\"} | select(span.llm.model_name, span.litellm.key_alias, span.llm.token_count.total, status)",
          "limit": 30,
          "spss": 20,
          "tableType": "spans"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Claude Code & dsh",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Claude Code: LLM calls / min by model",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_request_model) (rate(traces_spanmetrics_calls_total{service=\"claude-code\", span_name=\"claude_code.llm_request\"}[5m])) * 60",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tool calls / min by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"claude-code|dsh\", span_name=~\"claude_code.tool|dsh.tool\"}[5m])) * 60",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Claude Code turns (claude_code.interaction)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"claude-code\" && name=\"claude_code.interaction\"} | select(span.user_prompt_length, span.parent.source, resource.openinference.project.name)",
          "limit": 30,
          "spss": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 14,
      "type": "table",
      "title": "dsh sessions (dsh.session)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"dsh\" && name=\"dsh.session\"}",
          "limit": 30,
          "spss": 20,
          "tableType": "traces"
        }
      ]
    }
  ]
}